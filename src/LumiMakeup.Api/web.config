<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <!--
        stdoutLogEnabled="true" LIGADO DE PROPOSITO.

        Estava em "false", e e a razao de a API ter caido sem deixar rastro: sem
        ele o ANCM nao escreve em lugar nenhum o que impediu a aplicacao de
        subir, e o unico sinal e o 500.30 do IIS - que nao diz a causa.

        O ANCM cria a pasta .\logs sozinho na primeira gravacao, entao nao ha
        preparacao manual, e o arquivo pode ser lido por FTP depois do deploy.

        NAO reintroduzir o bloco <security><requestFiltering>. Ele foi tentado e
        nunca foi validado contra o IIS - so contra o XML - e e suspeito na queda
        da API. Se o limite do corpo da requisicao for necessario um dia, ele
        entra depois de testado isolado.
      -->
      <aspNetCore processPath="dotnet"
                  arguments=".\LumiMakeup.Api.dll"
                  stdoutLogEnabled="true"
                  stdoutLogFile=".\logs\stdout"
                  hostingModel="inprocess">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
        </environmentVariables>
      </aspNetCore>
    </system.webServer>
  </location>
</configuration>
